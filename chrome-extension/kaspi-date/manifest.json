{
  "manifest_version": 3,
  "name": "GRANTS BOOK — Kaspi даты",
  "version": "1.4.6",
  "description": "GRANTS BOOK: Kaspi даты и WB цены через браузер, автообновление каждые 5 минут.",
  "permissions": [
    "tabs",
    "storage",
    "alarms",
    "scripting"
  ],
  "host_permissions": [
    "https://grants-book-kaspi-assistant.vercel.app/*",
    "https://grants-book-kaspi-assistant-dias10.vercel.app/*",
    "https://*.vercel.app/*",
    "https://kaspi.kz/*",
    "https://card.wb.ru/*",
    "https://www.wildberries.ru/*",
    "https://global.wildberries.ru/*",
    "https://wildberries.kz/*",
    "https://www.wildberries.kz/*",
    "https://*.wildberries.kz/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://grants-book-kaspi-assistant.vercel.app/*",
        "https://grants-book-kaspi-assistant-dias10.vercel.app/*",
        "https://*.vercel.app/*"
      ],
      "js": [
        "grants-bridge.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://kaspi.kz/*"
      ],
      "js": [
        "kaspi-automation.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "GRANTS BOOK — Kaspi даты"
  }
}
