DATABASE_URL="postgresql://postgres:postgres@localhost:5432/marketplace_manager"
KASPI_API_TOKEN=""
KASPI_API_BASE_URL="https://kaspi.kz/shop/api/v2"

# Vercel -> Google Sheets direct sync for Wildberries prices.
# Preferred: paste the complete Google service-account JSON as one Vercel secret.
GOOGLE_SERVICE_ACCOUNT_JSON=""
# Or use the next two variables instead of GOOGLE_SERVICE_ACCOUNT_JSON:
GOOGLE_SERVICE_ACCOUNT_EMAIL=""
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=""

GOOGLE_SPREADSHEET_ID="1dLU5KOi3WBLy3uNEiqGv5rf9ka0OwcEw_RjhDQW3H1E"
GOOGLE_SHEET_NAME="Прайс KASPI"

# Optional protection for /api/wb-sheets-sync. Send Authorization: Bearer <value>.
WB_SYNC_SECRET=""

# WB location is resolved automatically from Astana coordinates.
# WB_DESTINATION can be set as a fallback if Wildberries geo endpoint is unavailable.
WB_DESTINATION=""
WB_ASTANA_LAT="51.169392"
WB_ASTANA_LON="71.449074"
