{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": [
    "fra1"
  ],
  "rewrites": [
    {
      "source": "/api/flip/poll-orders",
      "destination": "/api/data?module=flip&op=poll"
    },
    {
      "source": "/api/flip",
      "destination": "/api/data?module=flip"
    },
    {
      "source": "/api/orders-export",
      "destination": "/api/data?op=orders-export"
    },
    {
      "source": "/api/analytics",
      "destination": "/api/data?module=analytics"
    },
    {
      "source": "/api/quality",
      "destination": "/api/data?module=quality"
    },
    {
      "source": "/quality",
      "destination": "/quality.html"
    }
  ],
  "functions": {
    "api/wb-sheets-sync-v3.js": {
      "includeFiles": "node_modules/impit-linux-*/**"
    },
    "api/data.js": {
      "maxDuration": 300
    }
  },
  "crons": [
    {
      "path": "/api/data?module=quality&op=cron",
      "schedule": "17 1 * * *"
    },
    {
      "path": "/api/data?module=flip&op=daily",
      "schedule": "0 20 * * *"
    }
  ]
}
